@page "/game/{GameName}/player/{PlayerId:guid}"
@using GameLogic
@using GameLogic.Game
@using GameLogic.Profiles
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.SignalR
@inject SignalRService signalR
@inject Microsoft.JSInterop.IJSRuntime JS
@inject GameFrontend.ProfileService profiles
@implements IAsyncDisposable


@if (connectionError is not null)
{
  <div class="alert alert-warning" role="alert">
    @connectionError <a href="/">Return to the lobby</a>
  </div>
}
@if (game != null)
{
  <div class="game-screen">
    <div class="game-hud">
      <div class="d-flex flex-wrap align-items-center gap-2">
        <strong>Map: @(game.Map?.Name ?? "Unknown")</strong>
        <span>@game.MatchType</span>
        @if (LocalTank?.Team is int myTeam)
        {
          <span>&middot; You're on @Teams.Name(myTeam)</span>
        }
        @if (game.SecondsLeft is int secondsLeft)
        {
          <span>Time left: @(secondsLeft / 60):@((secondsLeft % 60).ToString("00"))</span>
        }
      </div>
      @if (WatchingOther)
      {
        <div class="small mb-2">@(LocalTank?.Respawning == true ? "Waiting to respawn" : "Eliminated") &middot; @(CameraTarget is null ? "No living players to follow" : $"Following {CameraTarget.Id.ToString()[^5..]}")</div>
      }
    </div>
    @if (LocalTank?.Earned is { } earned)
    {
      <div class="cash-hud" aria-live="off" title="Cash earned this match, paid when it ends or you leave">
        <span class="cash-hud-icon" aria-hidden="true">💰</span>
        <span class="cash-hud-value" @key="earned.Cash">+@earned.Cash</span>
        <span class="cash-hud-detail">@earned.Hits @(earned.Hits == 1 ? "hit" : "hits") &middot; @earned.Kills @(earned.Kills == 1 ? "kill" : "kills")</span>
      </div>
    }
    @if (game.Status == GameStatus.Ended && !summaryDismissed)
    {
      var rates = CurrencyRates.Default;
      var outcome = Outcome;
      <div class="match-over" role="dialog" aria-labelledby="match-over-title">
        <h2 id="match-over-title" class="match-over-title match-over-@outcome.Css">@outcome.Title</h2>
        @if (outcome.Subtitle is { } subtitle)
        {
          <p class="match-over-subtitle">@subtitle</p>
        }
        @if (game.Standings is { Length: > 0 } standings)
        {
          <div class="leaderboard">
            <div class="leaderboard-row leaderboard-head">
              <span></span><span>Tank</span><span>Result</span><span>Kills</span><span>Cash</span>
            </div>
            @for (var place = 0; place < standings.Length; place++)
            {
              var row = standings[place];
              <div class="leaderboard-row place-@(place + 1) @(row.TankId == PlayerId ? "is-you" : "")">
                <span class="place-medal" aria-label="@PlaceNames[place] place">@(place + 1)</span>
                <span class="leaderboard-tank">
                  <img src="images/PNG/Tanks/tank@(TankPalette.TankColor(row.TankId, row.IsBot, row.Team)).png" alt="" width="36" height="36" />
                  <span class="leaderboard-name">@(row.IsBot ? "🤖 " : "")@row.Name@(row.TankId == PlayerId ? " (you)" : "")</span>
                </span>
                <span class="result-badge @(row.Won ? "won" : "lost")">@(row.Won ? "WIN" : outcome.Draw ? "DRAW" : "LOSE")</span>
                <span>@row.Kills</span>
                <span class="leaderboard-cash">@(row.Cash is long cash ? $"+{cash}" : "—")</span>
              </div>
            }
          </div>
        }
        @if (LocalTank?.Earned is { } result)
        {
          <h3 class="payout-heading">Your payout</h3>
          <table class="payout-table">
            <tr><td>Time played (@FormatTime(result.Seconds))</td><td>+@(result.Seconds / rates.SecondsPerCash)</td></tr>
            <tr><td>Hits (@result.Hits &times; @rates.CashPerHit)</td><td>+@(result.Hits * rates.CashPerHit)</td></tr>
            <tr><td>Kills (@result.Kills &times; @rates.CashPerKill)</td><td>+@(result.Kills * rates.CashPerKill)</td></tr>
            <tr class="payout-total"><td>Total</td><td>+@result.Cash</td></tr>
          </table>
          @if (balance is not null)
          {
            <p class="payout-balance">New balance: <strong>@balance</strong></p>
          }
        }
        <div class="payout-actions">
          <a href="/" class="btn btn-primary">Return to lobby</a>
          <button type="button" class="btn btn-outline-light" @onclick="DismissSummary">Close</button>
        </div>
      </div>
    }
      <PlayerControls GameName=@GameName PlayerId=PlayerId ViewportChanged="ResizeViewport" Camera="Camera">
        @if (game.Map is { } map)
        {
          <MapSurface Map="map" />
        }
        @foreach (var tank in game.Tanks ?? [])
        {
          <TankComponent @key=tank.Id Tank=tank VisualTopOffset="@game.DeveloperSettings.VisualTopOffset" MaxHealth="@game.Settings.Health" MaxLives="@game.Settings.Lives" ReloadMs="@game.Settings.ReloadMs" />
          @if (showHitbox && game.MatchType == GameMatchTypes.DeveloperSimulation)
          {
            var area = Tank.GetCollisionArea(new Tank { PositionX = tank.PositionX, PositionY = tank.PositionY }, game.DeveloperSettings);
            <div class="tank-hitbox" style="@($"{RenderConstants.TickInterpolateStyle}; position: absolute; left: {area.X}px; top: {area.Y}px; width: {area.Width}px; height: {area.Height}px; border: 1px solid #e00060; background: #e0006018; pointer-events: none; z-index: 10;")"></div>
          }
        }
        @if (LocalTank is { Respawning: true, PendingSpawn: { } spawn })
        {
          @* Private to this player: the server only sends it to the owner *@
          <div class="spawn-marker" title="You respawn here"
               style="@($"left: {spawn.X}px; top: {spawn.Y - game.DeveloperSettings.VisualTopOffset}px; width: {Tank.Size}px; height: {Tank.Size}px;")"></div>
        }
        <BulletsComponent Bullets="@(game.Bullets ?? [])" Tanks="@(game.Tanks ?? [])" />
        <ExplosionsComponent Explosions="@(game.Explosions ?? [])" />
        @foreach (var popup in cashPopups)
        {
          <div @key="popup.Id" class="cash-popup @(popup.Kill ? "cash-popup-kill" : "")"
               style="@($"left: {popup.X}px; top: {popup.Y}px;")">@(popup.Kill ? "KILL " : "")+@popup.Amount</div>
        }
      </PlayerControls>
    @if (viewportMeasured && game.Map is { Mode: MapMode.Foggish } fogMap)
    {
      <FogMinimap @key="GameName" Map="fogMap" Tanks="@(game.Tanks ?? [])" PlayerId="PlayerId" Camera="Camera"
                  Width="viewportWidth" Height="viewportHeight" VisualTopOffset="game.DeveloperSettings.VisualTopOffset" />
    }

    <button type="button" class="settings-toggle" aria-label="Open settings" title="Settings"
            aria-haspopup="dialog" aria-controls="game-settings" @onclick="OpenSettings">
      <svg viewBox="0 0 24 24" aria-hidden="true" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2">
        <path d="m9 3-.7 2.5-2.2 1.3-2.5-.6-2 3.6 1.8 1.9v2.6l-1.8 1.9 2 3.6 2.5-.6 2.2 1.3L9 23h4l.7-2.5 2.2-1.3 2.5.6 2-3.6-1.8-1.9v-2.6l1.8-1.9-2-3.6-2.5.6-2.2-1.3L13 3Z" transform="translate(1 -1) scale(.95)" />
        <circle cx="11.5" cy="11.5" r="3.5" />
      </svg>
    </button>
    <dialog id="game-settings" class="settings-modal" @ref="settingsDialog" aria-labelledby="settings-title">
      <header class="settings-header">
        <h2 id="settings-title">Settings</h2>
        <button type="button" class="btn-close" aria-label="Close settings" @onclick="CloseSettings"></button>
      </header>
      <p>Drive with WASD or the arrow keys, aim with the mouse, and click to fire.</p>
      <a href="/" class="btn btn-outline-secondary mb-3">Return to lobby</a>
      <div class="settings-panels">

    @if (game.MatchType == GameMatchTypes.DeveloperSimulation)
    {
      <aside class="developer-settings">
        <h3 style="font-size: 1rem; margin-bottom: 12px;">Developer settings</h3>
        <button type="button" class="btn btn-outline-secondary mb-3" @onclick="ResetDeveloperSettings">Reset to defaults</button>
        <button type="button" class="btn btn-outline-secondary mb-3" @onclick="AddTargetTank">Add target tank</button>
        <button type="button" class="btn btn-outline-secondary mb-3" @onclick="AddBot">Add bot</button>
        <table class="table table-sm small mb-3">
          <thead><tr><th>Tank</th><th>HP</th><th>Lives</th><th>Hits</th></tr></thead>
          <tbody>
            @foreach (var tank in game.Tanks ?? [])
            {
              <tr>
                <td>@tank.Id.ToString()[^5..]@(tank.IsBot ? " 🤖" : "")@(tank.Id == PlayerId ? " (you)" : "")</td>
                <td>@(tank.Health is int health ? $"{health}/{game.Settings.Health}" : "?")</td>
                <td>@(tank.Eliminated ? "out" : tank.Respawning ? $"respawn {(tank.RespawnTicksLeft + 9) / 10}s" : tank.Deaths is int deaths ? (game.Settings.Lives - deaths).ToString() : "?")</td>
                <td>@tank.HitsLanded</td>
              </tr>
            }
          </tbody>
        </table>
        <p class="small text-muted">
          @game.Settings.Projectile.Label() · bullets @(game.Bullets?.Count() ?? 0) · explosions @(game.Explosions?.Count() ?? 0)
        </p>
        <label class="form-check mb-2">
          <input class="form-check-input" type="checkbox" @bind="showHitbox"> Show hitbox
        </label>
        <label class="form-check mb-3">
          <input class="form-check-input" type="checkbox" checked="@slideAlongWalls" @onchange="SetSlideAlongWalls"> Slide along walls
        </label>

        <label class="form-label d-block">
          Hitbox inset: @hitboxInset
          <input class="form-range" type="range" min="0" max="24" value="@hitboxInset" @oninput="SetHitboxInset">
        </label>

        <label class="form-label d-block">
          Visual top offset: @visualTopOffset
          <input class="form-range" type="range" min="0" max="60" value="@visualTopOffset" @oninput="SetVisualTopOffset">
        </label>

        <label class="form-label d-block">
          Collision step: @collisionStepPixels
          <input class="form-range" type="range" min="1" max="12" value="@collisionStepPixels" @oninput="SetCollisionStepPixels">
        </label>

        <label class="form-label d-block">
          Acceleration: @forwardAcceleration
          <input class="form-range" type="range" min="1" max="30" value="@forwardAcceleration" @oninput="SetForwardAcceleration">
        </label>

        <label class="form-label d-block">
          Brake: @brakeAcceleration
          <input class="form-range" type="range" min="-30" max="0" value="@brakeAcceleration" @oninput="SetBrakeAcceleration">
        </label>

        <label class="form-label d-block">
          Max speed: @maxSpeed
          <input class="form-range" type="range" min="1" max="160" value="@maxSpeed" @oninput="SetMaxSpeed">
        </label>

        <label class="form-label d-block">
          Turn degrees per tick: @turnDegrees (180 = instant)
          <input class="form-range" type="range" min="1" max="180" value="@turnDegrees" @oninput="SetTurnDegrees">
        </label>

        <label class="form-label d-block">
          Reverse speed multiplier: @backwardSpeedMultiplier.ToString("0.00")
          <input class="form-range" type="range" min="0.10" max="1.50" step="0.05" value="@backwardSpeedMultiplier" @oninput="SetBackwardSpeedMultiplier">
        </label>

        <label class="form-label d-block">
          Boost drain per tick: @boostDrainPerTick.ToString("0.0")
          <input class="form-range" type="range" min="0.1" max="20" step="0.1" value="@boostDrainPerTick" @oninput="SetBoostDrainPerTick">
        </label>

        <label class="form-label d-block">
          Boost regen per tick: @boostRegenPerTick.ToString("0.0")
          <input class="form-range" type="range" min="0.1" max="20" step="0.1" value="@boostRegenPerTick" @oninput="SetBoostRegenPerTick">
        </label>

        <label class="form-label d-block">
          Boost speed multiplier: @boostSpeedMultiplier.ToString("0.00")
          <input class="form-range" type="range" min="1.0" max="4.0" step="0.05" value="@boostSpeedMultiplier" @oninput="SetBoostSpeedMultiplier">
        </label>
      </aside>
    }

    @if (game.CreatorId == PlayerId)
    {
      <MatchSettingsPanel Settings="game.Settings" Changed="SendMatchSettings"
                          AllowLockedEdits="@(game.MatchType == GameMatchTypes.DeveloperSimulation)"
                          ShowBotDifficulty="@(game.MatchType != GameMatchTypes.Multiplayer || game.Settings.BotCount > 0)" />
    }
      </div>
    </dialog>
  </div>
}

@code {
  private ElementReference settingsDialog;
  private Task OpenSettings() => JS.InvokeVoidAsync("tankViewport.openSettings", settingsDialog).AsTask();
  private Task CloseSettings() => JS.InvokeVoidAsync("tankViewport.closeSettings", settingsDialog).AsTask();
  [Parameter]
  public string GameName { get; set; } = string.Empty;

  [Parameter]
  public Guid PlayerId { get; set; }

  private GameState? game = null;

  // Floating "+5" / "KILL +30" over the tank we hit when a hit or kill lands. Purely cosmetic and client-side:
  // they come from the change in the server's running totals between two updates
  private sealed record CashPopup(long Id, int Amount, bool Kill, int X, int Y, long ExpiresAt);
  private const int PopupMs = 1200;
  private readonly List<CashPopup> cashPopups = [];
  private Earnings? lastEarned;
  private long nextPopupId;
  private bool summaryDismissed;
  private long? balance;
  private bool balanceRequested;

  private void DismissSummary() => summaryDismissed = true;

  private static readonly string[] PlaceNames = ["Gold", "Silver", "Bronze"];

  private record MatchOutcome(string Title, string Css, string? Subtitle, bool Draw = false);

  // How the match ended for this player
  private MatchOutcome Outcome
  {
    get
    {
      if (game?.WinningTeam is int team)
      {
        var mine = team == LocalTank?.Team;
        return new(mine ? "VICTORY" : "DEFEAT", mine ? "win" : "lose", $"{Teams.Name(team)} team wins");
      }
      if (game?.BotsWon == true)
        return new("DEFEAT", "lose", "The bots won");
      if (game?.WinnerId is not Guid winner)
        return new("DRAW", "draw", "Nobody won", Draw: true);
      return winner == PlayerId
        ? new("VICTORY", "win", null)
        : new("DEFEAT", "lose", $"{game.Tanks?.FirstOrDefault(t => t.Id == winner)?.Name ?? "Another player"} wins");
    }
  }

  private static string FormatTime(long seconds) => $"{seconds / 60}:{(seconds % 60):00}";

  private void TrackCash(GameState state)
  {
    var now = Environment.TickCount64;
    cashPopups.RemoveAll(popup => popup.ExpiresAt <= now);
    var tank = state.Tanks?.FirstOrDefault(t => t.Id == PlayerId);
    var earned = tank?.Earned;
    if (earned is not null && lastEarned is not null && tank is not null)
    {
      var hits = (int)(earned.Hits - lastEarned.Hits);
      var kills = (int)(earned.Kills - lastEarned.Kills);
      if (hits > 0 || kills > 0)
      {
        var rates = CurrencyRates.Default;
        // Over the tank that was hit; over our own if it can't be found
        var hit = state.Tanks?.FirstOrDefault(t => t.Id == tank.LastHitTargetId) ?? tank;
        cashPopups.Add(new CashPopup(nextPopupId++, hits * rates.CashPerHit + kills * rates.CashPerKill, kills > 0,
          hit.PositionX + Tank.Size / 2 - 30, hit.PositionY - state.DeveloperSettings.VisualTopOffset - 10, now + PopupMs));
      }
    }
    lastEarned = earned;

    // The payout happens before the final update goes out, so the balance is already up to date by now
    if (state.Status == GameStatus.Ended && earned is not null && !balanceRequested)
    {
      balanceRequested = true;
      _ = LoadBalance();
    }
  }

  private async Task LoadBalance()
  {
    try
    {
      balance = (await profiles.LoadAsync()).Cash;
      await InvokeAsync(StateHasChanged);
    }
    catch (Exception) { /* The summary still shows what was earned */ }
  }
  private TankState? LocalTank => game?.Tanks?.FirstOrDefault(t => t.Id == PlayerId);
  private bool WatchingOther => LocalTank is { } tank && (tank.Respawning || tank.Eliminated);
  private Guid? followedPlayer;
  private TankState? CameraTarget
  {
    get
    {
      var target = MapCamera.FollowTarget(game?.Tanks ?? [], PlayerId, followedPlayer);
      followedPlayer = target?.Id;
      return target;
    }
  }
  private bool viewportMeasured;
  private double viewportWidth = 900;
  private double viewportHeight = 700;
  private double cameraCenterX;
  private double cameraCenterY;
  private void ResizeViewport((double Width, double Height) size)
  {
    viewportMeasured = true;
    viewportWidth = size.Width;
    viewportHeight = size.Height;
  }
  private MapCamera Camera
  {
    get
    {
      if (game?.Map is not { } map) return new(1, 0, 0);
      if (CameraTarget is { } target)
      {
        cameraCenterX = target.PositionX + Tank.Size / 2;
        cameraCenterY = target.PositionY - game.DeveloperSettings.VisualTopOffset + Tank.Size / 2;
      }
      return MapCamera.For(map, cameraCenterX, cameraCenterY, viewportWidth, viewportHeight);
    }
  }
  private bool developerSettingsLoaded = false;
  private bool showHitbox;
  private bool slideAlongWalls;
  private int hitboxInset = new DeveloperGameSettings().HitboxInset;
  private int visualTopOffset = new DeveloperGameSettings().VisualTopOffset;
  private int collisionStepPixels = 1;
  private int forwardAcceleration = 8;
  private int brakeAcceleration = new DeveloperGameSettings().BrakeAcceleration;
  private int maxSpeed = new DeveloperGameSettings().MaxSpeed;
  private int turnDegrees = new DeveloperGameSettings().TurnDegrees;
  private double backwardSpeedMultiplier = 0.65;
  private double boostDrainPerTick = new DeveloperGameSettings().BoostDrainPerTick;
  private double boostRegenPerTick = new DeveloperGameSettings().BoostRegenPerTick;
  private double boostSpeedMultiplier = new DeveloperGameSettings().BoostSpeedMultiplier;

  private IDisposable? gameSubscription;
  private bool disposed;
  private string? connectionError;
  private bool profiling;
  private long nextPing;
  private string? subscribedGame;
  private async Task Resubscribe(string? connectionId)
  {
    if (!disposed && signalR.HubConnection is { } connection)
      try { await connection.InvokeAsync(Messages.SubscribeToGame, GameName, PlayerId); connectionError = null; }
      catch (HubException ex) { game = null; connectionError = ex.Message; await InvokeAsync(StateHasChanged); }
  }
  protected override async Task OnParametersSetAsync()
  {
    profiling = ((IJSInProcessRuntime)JS).Invoke<bool>("tankPerf.isEnabled");
    await signalR.EnsureConnected();

    if (subscribedGame == GameName) return;
    if (subscribedGame is not null && signalR.HubConnection is { } previous)
      await previous.InvokeAsync("UnsubscribeFromGame", subscribedGame);
    gameSubscription?.Dispose();
    game = null;
    cashPopups.Clear();
    lastEarned = null;
    summaryDismissed = false;
    balanceRequested = false;
    balance = null;
    subscribedGame = GameName;
    gameSubscription = signalR.HubConnection?.On<GameState>(Messages.GameUpdate, (gameState) =>
    {
      if (disposed || gameState.Name != GameName) return;
      ((Microsoft.JSInterop.IJSInProcessRuntime)JS).InvokeVoid("tankPerf.received", gameState.Tick,
        gameState.ServerWorkMs, gameState.ServerIntervalMs, gameState.ServerBroadcastMs);
      // Live snapshots omit the immutable map. Keep the initial map instance and its cached SVG.
      game = gameState with { Map = gameState.Map ?? game?.Map };
      TrackCash(game);
      if (gameState.MatchType == GameMatchTypes.DeveloperSimulation && !developerSettingsLoaded)
      {
        LoadDeveloperSettings(gameState.DeveloperSettings);
      }
      InvokeAsync(StateHasChanged);
    });

    if (signalR.HubConnection is { } connection)
    {
      connection.Reconnected -= Resubscribe;
      connection.Reconnected += Resubscribe;
      try { await connection.InvokeAsync(Messages.SubscribeToGame, GameName, PlayerId); connectionError = null; }
      catch (HubException ex) { game = null; connectionError = ex.Message; await InvokeAsync(StateHasChanged); }
    }

  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (game is not null)
      await JS.InvokeVoidAsync("tankPerf.rendered", game.Tick, LocalTank?.InputSequence ?? 0);
    if (profiling && Environment.TickCount64 >= nextPing && signalR.HubConnection is { State: HubConnectionState.Connected } connection)
    {
      nextPing = Environment.TickCount64 + 2000;
      var at = System.Diagnostics.Stopwatch.GetTimestamp();
      try
      {
        await connection.InvokeAsync<long>("PerformancePing");
        await JS.InvokeVoidAsync("tankPerf.sample", "roundTripMs", System.Diagnostics.Stopwatch.GetElapsedTime(at).TotalMilliseconds);
      }
      catch (Exception) { }
    }
  }

  public async ValueTask DisposeAsync()
  {
    disposed = true;
    gameSubscription?.Dispose();
    if (signalR.HubConnection is { } connection)
    {
      connection.Reconnected -= Resubscribe;
      if (connection.State == HubConnectionState.Connected && subscribedGame is not null)
        try { await connection.InvokeAsync("UnsubscribeFromGame", subscribedGame); }
        catch (Exception) { /* Connection may close during navigation. */ }
    }
  }

  private void LoadDeveloperSettings(DeveloperGameSettings settings)
  {
    slideAlongWalls = settings.SlideAlongWalls;
    hitboxInset = settings.HitboxInset;
    visualTopOffset = settings.VisualTopOffset;
    collisionStepPixels = settings.CollisionStepPixels;
    forwardAcceleration = settings.ForwardAcceleration;
    brakeAcceleration = settings.BrakeAcceleration;
    maxSpeed = settings.MaxSpeed;
    turnDegrees = settings.TurnDegrees;
    backwardSpeedMultiplier = settings.BackwardSpeedMultiplier;
    boostDrainPerTick = settings.BoostDrainPerTick;
    boostRegenPerTick = settings.BoostRegenPerTick;
    boostSpeedMultiplier = settings.BoostSpeedMultiplier;
    developerSettingsLoaded = true;
  }

  private async Task SetHitboxInset(ChangeEventArgs e)
  {
    hitboxInset = ReadInt(e, hitboxInset);
    await SendDeveloperSettings();
  }

  private async Task SetVisualTopOffset(ChangeEventArgs e)
  {
    visualTopOffset = ReadInt(e, visualTopOffset);
    await SendDeveloperSettings();
  }

  private async Task SetCollisionStepPixels(ChangeEventArgs e)
  {
    collisionStepPixels = ReadInt(e, collisionStepPixels);
    await SendDeveloperSettings();
  }

  private async Task SetForwardAcceleration(ChangeEventArgs e)
  {
    forwardAcceleration = ReadInt(e, forwardAcceleration);
    await SendDeveloperSettings();
  }

  private async Task SetBrakeAcceleration(ChangeEventArgs e)
  {
    brakeAcceleration = ReadInt(e, brakeAcceleration);
    await SendDeveloperSettings();
  }

  private async Task SetMaxSpeed(ChangeEventArgs e)
  {
    maxSpeed = ReadInt(e, maxSpeed);
    await SendDeveloperSettings();
  }

  private async Task SetTurnDegrees(ChangeEventArgs e)
  {
    turnDegrees = ReadInt(e, turnDegrees);
    await SendDeveloperSettings();
  }

  private async Task SetBackwardSpeedMultiplier(ChangeEventArgs e)
  {
    backwardSpeedMultiplier = ReadDouble(e, backwardSpeedMultiplier);
    await SendDeveloperSettings();
  }

  private async Task SetBoostDrainPerTick(ChangeEventArgs e)
  {
      boostDrainPerTick = ReadDouble(e, boostDrainPerTick);
      await SendDeveloperSettings();
  }

  private async Task SetBoostRegenPerTick(ChangeEventArgs e)
  {
      boostRegenPerTick = ReadDouble(e, boostRegenPerTick);
      await SendDeveloperSettings();
  }

  private async Task SetBoostSpeedMultiplier(ChangeEventArgs e)
  {
      boostSpeedMultiplier = ReadDouble(e, boostSpeedMultiplier);
      await SendDeveloperSettings();
  }

  private async Task SendDeveloperSettings()
  {
    var settings = new DeveloperGameSettings
    {
      SlideAlongWalls = slideAlongWalls,
      HitboxInset = hitboxInset,
      VisualTopOffset = visualTopOffset,
      CollisionStepPixels = collisionStepPixels,
      ForwardAcceleration = forwardAcceleration,
      BrakeAcceleration = brakeAcceleration,
      MaxSpeed = maxSpeed,
      TurnDegrees = turnDegrees,
      BackwardSpeedMultiplier = backwardSpeedMultiplier,
      BoostDrainPerTick = boostDrainPerTick,
      BoostRegenPerTick = boostRegenPerTick,
      BoostSpeedMultiplier = boostSpeedMultiplier
    };

    await signalR.HubConnection?.SendAsync(Messages.UpdateDeveloperSettings, GameName, settings)!;
  }

  private async Task ResetDeveloperSettings()
  {
    showHitbox = false;
    LoadDeveloperSettings(new DeveloperGameSettings());
    await SendDeveloperSettings();
  }

  // The server checks that this player is the creator and echoes the result in the next update
  private async Task SendMatchSettings(MatchSettings settings)
  {
    await signalR.HubConnection?.SendAsync(Messages.UpdateMatchSettings, GameName, PlayerId, settings)!;
  }

  // Dev simulation only: another tank to shoot at (it just sits at its spawn point)
  private async Task AddTargetTank()
  {
    await signalR.HubConnection?.SendAsync(Messages.JoinGame, GameName, "", null)!;
  }

  // Dev simulation only: a computer tank that uses the match's bot difficulty
  private async Task AddBot()
  {
    await signalR.HubConnection?.SendAsync(Messages.AddBot, GameName)!;
  }

  private async Task SetSlideAlongWalls(ChangeEventArgs e)
  {
    slideAlongWalls = e.Value is true;
    await SendDeveloperSettings();
  }

  private static int ReadInt(ChangeEventArgs e, int fallback)
  {
    return int.TryParse(e.Value?.ToString(), out var value) ? value : fallback;
  }

  private static double ReadDouble(ChangeEventArgs e, double fallback)
  {
    return double.TryParse(e.Value?.ToString(), out var value) ? value : fallback;
  }

}
