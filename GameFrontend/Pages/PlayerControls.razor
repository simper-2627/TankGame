@using GameLogic
@using GameLogic.Game
@using Microsoft.AspNetCore.SignalR.Client
@inject SignalRService signalR
@implements IDisposable
@implements IHandleEvent
@inject Microsoft.JSInterop.IJSRuntime JS

<div tabindex="0" @ref="board" class="game-board"
     style="position: absolute; inset: 0; overflow: hidden; outline: none; background: #171e14;"
     @onkeydown="handleKeyDown" @onkeyup="handleKeyUp" @onblur="handleBlur" @onmousemove="handleMouseMove"
     @onmousedown="handleMouseDown" @onmouseup="handleMouseUp" @onmouseleave="handleMouseUp">
    <div style="@WorldStyle">
        @ChildContent
    </div>
</div>
<style>
    /* Double-clicking a tank (to shoot) must not select its label or drag its image */
    .game-board,
    .game-board * {
        user-select: none;
        -webkit-user-select: none;
    }

    .game-board img {
        -webkit-user-drag: none;
    }
</style>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    [Parameter]
    public string GameName { get; set; } = string.Empty;
    [Parameter]
    public Guid PlayerId { get; set; }
    [Parameter] public EventCallback<(double Width, double Height)> ViewportChanged { get; set; }
    private DotNetObjectReference<PlayerControls>? viewportReference;
    [JSInvokable]
    public Task ResizeViewport(double width, double height) => ViewportChanged.InvokeAsync((width, height));
    [Parameter] public MapCamera Camera { get; set; } = new(1, 0, 0);
    private string WorldStyle => FormattableString.Invariant($"position:absolute;left:0;top:0;transform-origin:0 0;transform:scale({Camera.Scale}) translate({-Camera.X}px,{-Camera.Y}px);pointer-events:none;transition:transform 100ms linear;will-change:transform;");
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg) => callback.InvokeAsync(arg);
    private long inputSequence;
    private double? cursorX;
    private double? cursorY;
    protected override void OnParametersSet() => UpdateAim();
    private void UpdateAim()
    {
        if (cursorX is double x && cursorY is double y)
            (aimX, aimY) = Camera.ToWorld(x, y);
    }
    private string[] movementKeys = ["ArrowUp", "ArrowLeft", "ArrowDown", "ArrowRight"];
    private const double inputCheckInterval = 0.02;
    private PlayerInputRequest? lastSentInput = null;
    private HashSet<string> pressedKeys = new HashSet<string>();
    private int? aimX = null;
    private int? aimY = null;
    private bool mouseHeld = false;
    // Set on press, cleared once sent, so a click shorter than one input check still fires
    private bool pressPending = false;
    private readonly CancellationTokenSource inputCancellation = new();
    private bool sending;
    private ElementReference board;
    // Focus the board as soon as it appears so keys work without clicking into it
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await board.FocusAsync();
            await JS.InvokeVoidAsync("tankPerf.attach", board);
            viewportReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("tankViewport.attach", board, viewportReference);
        }
        await JS.InvokeVoidAsync("tankPerf.count", "boardRenders");
    }
    protected override void OnInitialized() => _ = RunInputLoop();
    private async Task RunInputLoop()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(inputCheckInterval));
            while (await timer.WaitForNextTickAsync(inputCancellation.Token))
                await InvokeAsync(SendInputIfDifferent);
        }
        catch (OperationCanceledException) when (inputCancellation.IsCancellationRequested) { }
    }
    // WASD is an alias for the arrow keys
    private static string NormalizeKey(string key) => key.ToLowerInvariant() switch
    {
        "w" => "ArrowUp",
        "a" => "ArrowLeft",
        "s" => "ArrowDown",
        "d" => "ArrowRight",
        _ => key
    };
    private async Task handleKeyDown(KeyboardEventArgs e)
    {
        var key = NormalizeKey(e.Key);
        if (movementKeys.Contains(key))
            pressedKeys.Add(key);
        if (e.Key == "Shift" || e.Key == " ")
            pressedKeys.Add("Shift");
        await SendInputIfDifferent();
    }
    private async Task handleKeyUp(KeyboardEventArgs e)
    {
        pressedKeys.Remove(NormalizeKey(e.Key));
        if (e.Key == "Shift" || e.Key == " ")
            pressedKeys.Remove("Shift");
        await SendInputIfDifferent();
    }
    private void handleMouseMove(MouseEventArgs e)
    {
        // Tanks and bullets ignore the mouse, so the offset is always relative to the board
        cursorX = e.OffsetX;
        cursorY = e.OffsetY;
        UpdateAim();
    }
    private async Task handleMouseDown(MouseEventArgs e)
    {
        if (e.Button != 0)
            return;
        handleMouseMove(e);
        mouseHeld = true;
        pressPending = true;
        await SendInputIfDifferent();
    }
    private async Task handleMouseUp(MouseEventArgs e)
    {
        mouseHeld = false;
        await SendInputIfDifferent();
    }
    private async Task handleBlur()
    {
        pressedKeys = new HashSet<string>();
        mouseHeld = false;
        pressPending = false;
        await SendInputIfDifferent();
    }
    private async Task SendInputIfDifferent()
    {
        if (sending || inputCancellation.IsCancellationRequested || PlayerId == Guid.Empty || string.IsNullOrEmpty(GameName) ||
signalR.HubConnection?.State != HubConnectionState.Connected)
            return;

        var up = pressedKeys.Contains("ArrowUp");
        var left = pressedKeys.Contains("ArrowLeft");
        var right = pressedKeys.Contains("ArrowRight");
        var down = pressedKeys.Contains("ArrowDown");
        var shoot = mouseHeld || pressPending;
        var boost = pressedKeys.Contains("Shift");

        var movementMessage = new PlayerInputRequest
        {
            GameName = GameName,
            PlayerId = (Guid)PlayerId,
            Up = up,
            Left = left,
            Right = right,
            Shoot = shoot,
            Boost = boost,
            Down = down,
            AimX = aimX,
            AimY = aimY,
        };

        // The press is now part of the shooting state, whether or not this message differs
        if (shoot)
            pressPending = false;
        if (movementMessage != lastSentInput)
        {
            lastSentInput = movementMessage;
            movementMessage = movementMessage with { InputSequence = ++inputSequence };
            ((Microsoft.JSInterop.IJSInProcessRuntime)JS).InvokeVoid("tankPerf.sent", inputSequence);
            sending = true;
            try { await signalR.HubConnection!.SendAsync(Messages.PlayerInput, movementMessage); }
            catch (Exception) { lastSentInput = null; }
            finally { sending = false; }
        }
    }
    public void Dispose()
    {
        ((IJSInProcessRuntime)JS).InvokeVoid("tankViewport.detach", board);
        viewportReference?.Dispose();
        inputCancellation.Cancel();
    }
}
