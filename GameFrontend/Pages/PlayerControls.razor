@using GameLogic
@using GameLogic.Game
@using Microsoft.AspNetCore.SignalR.Client
@inject SignalRService signalR
@implements IDisposable

<div>
    Select box, drive with the arrow keys, and aim with the mouse
</div>
<div tabindex="0" 
class="p-1 m-1 border border-4 border-black rounded-4 game-board" 
style=@($"height: {BoardHeight}px; width: {BoardWidth}px; position: relative; overflow: hidden;")
@onkeydown="handleKeyDown" @onkeydown:preventDefault="true" @onkeyup="handleKeyUp" @onblur="handleBlur"
@onmousemove="handleMouseMove"
>
    @ChildContent
</div>
<style>
    .game-board:focus {
    border-color: blue !important;
    background-color: rgb(240, 240, 240);
    }
</style>

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }
    [Parameter]
    public string GameName { get; set; }
    [Parameter]
    public Guid PlayerId { get; set; }
    [Parameter]
    public int BoardWidth { get; set; } = 750;
    [Parameter]
    public int BoardHeight { get; set; } = 750;
    private string[] movementKeys = ["ArrowUp", "ArrowLeft", "ArrowDown", "ArrowRight", " "];
    private const double inputCheckInterval = 0.01;
    private PlayerInputRequest? lastSentInput = null;
    private HashSet<string> pressedKeys = new HashSet<string>();
    private int? aimX = null;
    private int? aimY = null;
    private Timer? sendInputTimer;
    protected override async Task OnInitializedAsync()
    {
        sendInputTimer = new Timer(
          SendInputIfDifferent,
          null,
          TimeSpan.Zero,
          TimeSpan.FromSeconds(inputCheckInterval)); // Executes every second
    }
    private void handleKeyDown(KeyboardEventArgs e)
    {
        if (movementKeys.Contains(e.Key))
            pressedKeys.Add(e.Key);
    }
    private void handleKeyUp(KeyboardEventArgs e)
    {
        pressedKeys.Remove(e.Key);
    }
    private void handleMouseMove(MouseEventArgs e)
    {
        // Tanks and bullets ignore the mouse, so the offset is always relative to the board
        aimX = (int)e.OffsetX;
        aimY = (int)e.OffsetY;
    }
    private void handleBlur()
    {
        pressedKeys = new HashSet<string>();
    }
    private void SendInputIfDifferent(object? state)
    {
        @if (PlayerId == null || GameName == null)
            return;

        var up = pressedKeys.Contains("ArrowUp");
        var left = pressedKeys.Contains("ArrowLeft");
        var right = pressedKeys.Contains("ArrowRight");
        var down = pressedKeys.Contains("ArrowDown");
        var shoot = pressedKeys.Contains(" ");

        var movementMessage = new PlayerInputRequest
      {
        GameName = GameName,
        PlayerId = (Guid)PlayerId,
        Up = up,
        Left = left,
        Right = right,
        Shoot = shoot,
        Down = down,
        AimX = aimX,
        AimY = aimY,
       };
      
    if (movementMessage != lastSentInput)
    {
      lastSentInput = movementMessage;
      signalR.HubConnection?.SendAsync(Messages.PlayerInput, movementMessage);
    }
  }
  public void Dispose()
  {
    sendInputTimer?.Dispose();
  }
}
